{
  "name": "pi-office",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ORCA24 Coworking Space — Observabilitas Realtime Sesi Indonesia & Sub-Agents",
  "scripts": {
    "dev": "node tools/run-dev.js",
    "server": "node server/src/index.js",
    "dashboard": "cd dashboard && npx ng serve --host 0.0.0.0 --port 4200",
    "build": "cd dashboard && npx ng build --configuration production",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "test": "node tools/test-e2e.js",
    "backfill:usage": "node tools/backfill-usage.js",
    "simulate": "node tools/simulate-pi-session.js",
    "bundle:extension": "node tools/build-global-extension.js",
    "sync:extension": "node tools/build-global-extension.js --install",
    "test:extension": "node tools/test-global-extension.js",
    "pi:office": "pi -e extension/index.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.185.4",
    "canvas-confetti": "^1.9.4",
    "lucide-angular": "^1.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "wrangler": "^4.129.0"
  }
}
