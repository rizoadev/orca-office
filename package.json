{
  "name": "orca-office",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ORCA24 Coworking Space — Observabilitas Realtime Sesi Indonesia & Sub-Agents",
  "scripts": {
    "dev": "node tools/run-dev.js",
    "server": "node server/src/index.js",
    "dashboard": "cd dashboard && npx ng serve --host 0.0.0.0 --port 4200 --hmr",
    "build": "cd dashboard && npx ng build --configuration production",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "test": "node tools/test-e2e.js",
    "backfill:usage": "node --env-file=.env tools/backfill-usage.js",
    "simulate": "node tools/simulate-pi-session.js",
    "bundle:extension": "node tools/build-global-extension.js",
    "sync:extension": "node tools/build-global-extension.js --install",
    "pack:extension": "node tools/build-global-extension.js && (cd packaging/pi-office && npm pack --dry-run)",
    "publish:extension": "node tools/publish-package.js --dry-run",
    "test:extension": "node tools/test-global-extension.js",
    "pi:office": "pi -e extension/index.ts",
    "publish:extension:live": "node tools/publish-package.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "wrangler": "^4.129.0"
  }
}
