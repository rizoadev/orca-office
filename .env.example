# Contoh environment file — salin ke cloud.env lalu isi nilai asli.
# File asli (cloud.env) berada di .gitignore dan tidak boleh di-commit.

# ── Cloudflare Worker (deploy) ─────────────────────────────────────────
# Account dan API token untuk `npm run cf:deploy`.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Turso (SQLite di cloud, dipakai Worker) ────────────────────────────
# Buat dulu: turso db create pi-office && turso db tokens create pi-office
TURSO_DATABASE_URL=libsql://pi-office-<nama-anda>.turso.io
TURSO_AUTH_TOKEN=

# ── Proteksi endpoint telemetry (opsional tapi disarankan) ─────────────
# Nilai ini juga harus di `wrangler secret put OFFICE_TOKEN` dan di
# export OFFICE_TOKEN=... pada mesin yang mengirim telemetry.
OFFICE_TOKEN=

# ── Hub lokal ──────────────────────────────────────────────────────────
# OFFICE_PORT=4317
# OFFICE_HOST=0.0.0.0
